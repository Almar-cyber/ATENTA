# Used ONLY by src/cli/enqueue.ts (a local script that talks to D1 over Cloudflare's REST API).
# The deployed Worker itself gets DB/MEDIA via wrangler.toml bindings and gets all secrets
# (TOKEN_ENCRYPTION_KEY, per-platform client id/secret) via `wrangler secret put` — none of
# those belong in this file or in wrangler.toml.

CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
