# Used by local CLI scripts (src/cli/*) that talk to D1 over Cloudflare's REST API instead of
# the Worker binding, which only exists inside the deployed Worker. The deployed Worker itself
# gets DB/MEDIA via wrangler.toml bindings and secrets via `wrangler secret put` — those never
# belong in this file.
#
# Deliberately NOT named CF_ACCOUNT_ID/CF_API_TOKEN: Wrangler auto-loads this same .env file and
# treats those exact names as legacy Cloudflare auth env vars, which silently overrides your
# `wrangler login` session with this D1-only-scoped token and breaks every other wrangler command
# (secret put, deploy, ...) run from this directory. Ask how we know.
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# Needed by src/cli/youtube-auth.ts to do the local loopback OAuth flow and encrypt the result
# before writing it to D1. Same values as the YOUTUBE_CLIENT_ID/SECRET and TOKEN_ENCRYPTION_KEY
# Worker secrets (see wrangler.toml comment) — duplicated here on purpose, since this script runs
# locally, not inside the Worker.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Needed by the *-auth-url.ts scripts to build each consent URL (only the client id/key — secrets
# are only ever used server-side, in the Worker's token exchange).
LINKEDIN_CLIENT_ID=
META_APP_ID=
PINTEREST_CLIENT_ID=
TIKTOK_CLIENT_KEY=

# Opcional: webhook (ntfy.sh ou Discord) pra alertas de falha do poller — ver README.
# Não é lido pelos CLIs; é secret do Worker (wrangler secret put ALERT_WEBHOOK_URL).
