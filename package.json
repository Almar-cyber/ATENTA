{
  "name": "social-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "build": "npm run web:build",
    "dev": "npm run web:build && wrangler dev",
    "deploy": "npm run web:build && wrangler deploy",
    "queue": "tsx src/cli/queue.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
